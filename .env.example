# Origin the Vite dev server runs on; CORS allows exactly this origin (never "*").
FRONTEND_ORIGIN=http://localhost:5173

# Backend base URL including the /api prefix. The frontend builds every API
# call as `${VITE_API_BASE_URL}/<resource>` (e.g. /tasks -> /api/tasks).
# This is the only variable name used for the API location.
VITE_API_BASE_URL=http://localhost:8000/api

# Path to the local SQLite database file used by the backend.
SQLITE_PATH=./data/app.db
